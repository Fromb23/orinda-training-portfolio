# MySQL connection used by Prisma. Never commit the real value.
DATABASE_URL="mysql://orinda:change-me@127.0.0.1:3306/orinda_portfolio"
# Absolute persistent directory outside the repository and web root.
UPLOAD_DIR="/var/lib/orinda-portfolio/uploads"
# At least 32 random bytes; used to key credential hashes.
TOKEN_HASH_KEY="replace-with-a-random-secret"
NEXT_PUBLIC_SITE_URL="https://portfolio.example.com"
# Full supervisor bearer entry link, shown only to an authenticated manager.
# Set this after `npm run access -- provision supervisor` prints the link once.
SUPERVISOR_SHARE_URL="https://portfolio.example.com/access/supervisor?token=REPLACE_ON_SERVER"
SESSION_TTL_HOURS="168"
MAX_FILE_BYTES="15728640"
MAX_FILES_PER_ASSIGNMENT="30"
MAX_UPLOAD_REQUEST_BYTES="15728640"
DB_CONNECTION_LIMIT="5"
